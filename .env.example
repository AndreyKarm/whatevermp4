# Database (PostgreSQL)
POSTGRES_USER=movieuser
POSTGRES_PASSWORD=ea0645717277d39c703a7086efef9271e253860d585c95e8f5d79d265f2bd88a
POSTGRES_DB=local
DB_PORT=5432

# S3 / RustFS Object Storage
S3_ACCESS_KEY=movies
S3_SECRET_KEY=ea0645717277d39c703a7086efef9271e253860d585c95e8f5d79d265f2bd88a
S3_REGION=us-east-1
S3_BUCKET=movies
RUSTFS_PORT=9044
RUSTFS_CONSOLE_PORT=9045
S3_PUBLIC_ENDPOINT=http://localhost:9044

# Backend (movie-server & movie-worker)
BACKEND_PORT=8088
PLAYBACK_SECRET=5a1f7593442279cd773638b37957b2bdf6b7cde811ef3302890de13ff6813f0c
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Worker video encoder: none (libx264) or nvenc. For nvenc, also start with
# the GPU override: docker compose -f docker-compose.yml -f docker-compose.nvidia.yml up
HW_ENCODER=none

# Frontend (movie-web)
FRONTEND_PORT=3000
ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8088
BODY_SIZE_LIMIT=10G

# HTTPS proxy (movie-proxy): the hostname browsers use (must resolve to this machine and be covered
# by the certificate), and where fullchain.pem / privkey.pem are downloaded from (re-checked every
# CERTS_REFRESH seconds; nginx reloads when they change). App: https://PUBLIC_HOST:1488, S3: :9044.
PUBLIC_HOST=movie.zero.catboy.fyi
CERTS_URL=https://ssl.zero.catboy.fyi
CERTS_REFRESH=21600
