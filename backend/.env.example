# Server Port & Binding
ADDR=:8088

# PostgreSQL Database URL
DATABASE_URL=postgres://movieuser:ea0645717277d39c703a7086efef9271e253860d585c95e8f5d79d265f2bd88a@localhost:5432/local?sslmode=disable

# S3 / RustFS Object Storage
S3_ENDPOINT=http://localhost:9044
S3_PUBLIC_ENDPOINT=http://localhost:9044
S3_REGION=us-east-1
S3_ACCESS_KEY=movies
S3_SECRET_KEY=ea0645717277d39c703a7086efef9271e253860d585c95e8f5d79d265f2bd88a
S3_BUCKET=movies

# Worker temporary directory for transcoding and torrent downloads
WORK_DIR=/tmp/work

# Worker: hardware video encoder, "nvenc" (NVIDIA) or "none" (libx264).
# Checked at startup; falls back to software if the GPU isn't usable.
HW_ENCODER=none
# Worker: /healthz and /metrics (Prometheus)
WORKER_ADDR=:8089

# CORS Allowed Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Playback URL signing secret
PLAYBACK_SECRET=5a1f7593442279cd773638b37957b2bdf6b7cde811ef3302890de13ff6813f0c
